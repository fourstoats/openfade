# Openfade environment variables
#
# This file documents the variables Openfade will use. None of them are read yet
# — the project has no implementation. They are listed here so that the
# intended configuration surface is public and reviewable before code exists
# that depends on it.
#
# Copy to .env and fill in what you need. Never commit .env.
#
# Openfade is model-agnostic. At least one provider key is required for hosted
# models, or none at all if you run local models.

# ─────────────────────────────────────────────────────────────
# Model providers (set at least one, or run local models)
# ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# OpenRouter and other OpenAI-compatible endpoints
OPENROUTER_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ─────────────────────────────────────────────────────────────
# Local models
# ─────────────────────────────────────────────────────────────

# Path to a local model, e.g. an Ollama or llama.cpp endpoint
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=

# ─────────────────────────────────────────────────────────────
# Corpus
# ─────────────────────────────────────────────────────────────

# Where the locally-built documentation corpus is stored.
# Built on your machine at ingest time. Openfade does not ship vendor
# documentation, and this is not synced anywhere.
OPENFADE_CORPUS_PATH=./.openfade/corpus

# Upstream documentation sources, pinned to versions.
# Pine and Lipi both evolve; pin deliberately so builds are reproducible.
PINECRAFT_PIN=6
LIPI_VERSION=1

# Set to false to run fully offline against a previously built corpus.
OPENFADE_ALLOW_NETWORK=true

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openfade
POSTGRES_USER=openfade
POSTGRES_PASSWORD=
# pgvector is required
OPENFADE_VECTOR_DIM=1536

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────

OPENFADE_LOG_LEVEL=info

# Openfade does not collect telemetry. If that ever changes it will be opt-in,
# documented on a dedicated page, and disclosed in README.md and SECURITY.md —
# not added quietly as a default.
OPENFADE_TELEMETRY=false

# ─────────────────────────────────────────────────────────────
# Execution safety
# ─────────────────────────────────────────────────────────────

# Openfade does not place, modify, or cancel live orders. There is no variable
# that enables this, by design. If execution is ever implemented it will require
# per-action human approval, not a configuration flag.
OPENFADE_EXECUTION_ENABLED=false
